; Engine configuration file.
; Engine: Godot 4.7
; Game: Dust & Iron - A Wild West Open World

config_version=5

[application]

config/name="Dust & Iron"
config/description="An open-world Western adventure on the frontier of the Red Hollow Territory."
config/version="1.0.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.05, 0.04, 0.03, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://resources/default_bus_layout.tres"

[autoload]

GameState="*res://scripts/systems/game_state.gd"
InputSetup="*res://scripts/systems/input_setup.gd"
SaveSystem="*res://scripts/systems/save_system.gd"
AudioManager="*res://scripts/systems/audio_manager.gd"
FXManager="*res://scripts/systems/fx_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

theme/custom="res://ui/western_theme.tres"
theme/default_font_multichannel_signed_distance_field=true

[ime]

default_ime=""

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="animals"
3d_physics/layer_5="props"
3d_physics/layer_6="interact"
3d_physics/layer_7="water"
3d_physics/layer_8="hitbox"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_jitter_fix=0.0
common/contact_reporting_enabled=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=false
scaling_3d/mode=0
scaling_3d/scale=1.0
environment/defaults/default_clear_color=Color(0.16, 0.19, 0.22, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/16_bits=false
occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_change/threshold_pixels=1.5
textures/default_filters/anisotropic_filtering_level=3
textures/default_filters/texture_mipmap_bias=0.0
textures/decals/filter=3
viewport/hdr_2d=true
environment/defaults/default_environment="res://resources/default_environment.tres"

[threading]

worker_pool/max_threads=1

[file_customization]

folder_colors={
"res://assets/": "orange",
"res://scenes/": "blue",
"res://scripts/": "green"
}
