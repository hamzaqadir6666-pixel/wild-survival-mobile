#include <winresrc.h>
#include "uninstall_res.h"

// Uninstaller icon & manifest
IDI_UNINSTALL_ICON ICON "../../assets/uninstall_icon.ico"
1 RT_MANIFEST "../common/uninstaller_manifest.xml"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AeroExplorer Open Source Project"
            VALUE "FileDescription", "Windows 7 Aero Explorer Uninstaller"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Uninstall"
            VALUE "LegalCopyright", "Copyright (c) 2026 AeroExplorer Project (MIT License)"
            VALUE "OriginalFilename", "Uninstall.exe"
            VALUE "ProductName", "Windows 7 Aero Explorer"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_UNINSTALL DIALOGEX 0, 0, 320, 176
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Windows 7 Aero Explorer Uninstall"
FONT 9, "Segoe UI"
BEGIN
    ICON            IDI_UNINSTALL_ICON, 1001, 12, 14, 32, 32
    LTEXT           "Windows 7 Aero Explorer 1.0.0", 1002, 56, 14, 250, 12
    LTEXT           "Setup will remove the application, its shortcuts and its shell integration from this computer.", 1003, 56, 30, 250, 26

    LTEXT           "Installation folder:", 1004, 14, 64, 90, 10
    LTEXT           "", 1005, 100, 64, 206, 10

    AUTOCHECKBOX    "Also delete saved FTP sites, settings and cached data", 1006, 14, 84, 290, 12
    AUTOCHECKBOX    "Remove the right-click 'Open in Windows 7 Aero Explorer' context menu entry", 1007, 14, 100, 296, 12

    LTEXT           "", 1008, 14, 120, 292, 20
    CONTROL         "", 1009, "msctls_progress32", WS_BORDER, 14, 142, 292, 10

    PUSHBUTTON      "Uninstall", IDOK, 196, 156, 56, 16, WS_DISABLED
    PUSHBUTTON      "Cancel", IDCANCEL, 258, 156, 56, 16
END
