#include <winresrc.h>
#include "setup_rc.h"

IDI_SETUP_ICON ICON "../../assets/setup_icon.ico"
IDB_WIZARD_BANNER BITMAP "../../assets/wizard_banner.bmp"
IDB_WIZARD_HEADER BITMAP "../../assets/wizard_header.bmp"

1 RT_MANIFEST "../common/installer_manifest.xml"

IDR_PAYLOAD RCDATA "aeroexplorer_payload.bin"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AeroExplorer Open Source Project"
            VALUE "FileDescription", "Windows 7 Aero Explorer Setup Wizard"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "AeroExplorerSetup"
            VALUE "LegalCopyright", "Copyright (c) 2026 AeroExplorer Project (MIT License)"
            VALUE "OriginalFilename", "AeroExplorerSetup.exe"
            VALUE "ProductName", "Windows 7 Aero Explorer"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Windows 7 setup wizard shell: 499 x 360 dialog units, banner on the left and
// an 18-du footer strip with the Back / Next / Cancel buttons. Every page
// control is created at runtime so each page can lay itself out precisely.
IDD_SETUP DIALOGEX 0, 0, 499, 360
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Windows 7 Aero Explorer Setup"
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON      "< &Back", IDC_BACK_BTN, 305, 322, 58, 16
    PUSHBUTTON      "&Next >", IDC_NEXT_BTN, 369, 322, 58, 16, WS_DISABLED
    PUSHBUTTON      "Cancel", IDC_CANCEL_BTN, 433, 322, 55, 16
END
